+        #expect(abs((report.data.first?.costUSD ?? 0) - hourlyCost) < 1e-9)
+        #expect((beforeHour?.costUSD ?? 0) > 0)
+        #expect((afterHour?.costUSD ?? 0) > 0)
+
+        let snapshot = CostUsageFetcher.tokenSnapshot(
