+            cacheCreate: 0,
+            cacheCreate1h: nil,
+            output: 10,
+            costNanos: 1_500_000_000,
+            costPriced: true)
+        let afterRow = CostUsageScanner.ClaudeUsageRow(
+            dayKey: dayKey,
+            model: model,
+            sessionId: "s",
+            messageId: "m2",
+            requestId: "r2",
+            timestampUnixMs: Int64(after.timeIntervalSince1970 * 1000),
