+    private static func quotaWeekDetailLine(week: CostUsageQuotaWeek, cost: String) -> String {
+        let label = Self.quotaWeekHistoryLabel(offset: week.offset)
+        guard let totalTokens = week.totalTokens else { return "\(label): \(cost)" }
+        return String(
+            format: L("%@: %@ · %@ tokens"),
+            label,
+            cost,
+            UsageFormatter.tokenCountString(totalTokens))
+    }
+
+    private static func quotaWeekHistoryLabel(offset: Int) -> String {
+        switch offset {
+        case 0:
+            return L("This week")
+        case 1:
+            return L("Last week")
+        default:
+            return L("%d weeks ago", offset)
+        }
+    }
